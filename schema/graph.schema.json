{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diagram-to-motion.dev/schemas/graph.schema.json",
  "title": "Diagram-to-Motion Graph Schema",
  "description": "Normalized graph structure representing an architecture or process topology.",
  "type": "object",
  "required": ["kind", "nodes", "edges"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["flowchart", "sequence"],
      "description": "The category of diagram."
    },
    "direction": {
      "type": "string",
      "enum": ["LR", "RL", "TD", "TB", "BT"],
      "default": "LR",
      "description": "Orientation for flowchart layout."
    },
    "source": {
      "type": "string",
      "description": "Original Mermaid source or human-readable description of origin."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-\\.]*$",
            "description": "Unique identifier for the node."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Display label for the node."
          },
          "shape": {
            "type": "string",
            "enum": ["rect", "round", "diamond", "cylinder", "stadium", "circle"],
            "default": "rect",
            "description": "Visual shape."
          },
          "subgraph": {
            "type": "string",
            "description": "Optional ID of the containing subgraph cluster."
          },
          "x": {
            "type": "number",
            "minimum": 100,
            "maximum": 20000,
            "description": "Optional SVG coordinate X."
          },
          "y": {
            "type": "number",
            "minimum": 100,
            "maximum": 20000,
            "description": "Optional SVG coordinate Y."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-\\.]*$",
            "description": "Unique identifier for the edge (e.g. e1, e2)."
          },
          "from": {
            "type": "string",
            "description": "Source node ID."
          },
          "to": {
            "type": "string",
            "description": "Target node ID."
          },
          "label": {
            "type": "string",
            "default": "",
            "description": "Text label shown along the edge."
          },
          "style": {
            "type": "string",
            "enum": ["solid", "dashed", "thick"],
            "default": "solid",
            "description": "Stroke rendering style."
          }
        }
      }
    },
    "subgraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "nodes"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier for the subgraph cluster."
          },
          "label": {
            "type": "string",
            "description": "Cluster title displayed in header."
          },
          "nodes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of node IDs belonging to this cluster."
          }
        }
      }
    }
  }
}
